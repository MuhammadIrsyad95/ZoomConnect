@model MeetingModel
@{
    ViewData["Title"] = "Meeting";
}
<div class="container mt-5">
    <div class="card shadow-lg p-4 border-0 rounded-3">
        <h2 class="text-center mb-4 text-primary">
            <img src="~/images/zoom connect 2.png" alt="Zone Logo" class="img-fluid" style="max-height: 100px;">
        </h2>
        <form asp-action="CreateMeeting" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input asp-for="Email" class="form-control" value="@ViewBag.UserEmail" readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Topic</label>
                    <input asp-for="Topic" class="form-control" required placeholder="Enter meeting topic" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Start Date</label>
                    <input asp-for="StartDate" id="startDate" class="form-control" type="date"
                           required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Start Time</label>
                    <input asp-for="StartTime" id="startTime" type="text" class="form-control timepicker" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">End Date</label>
                    <input asp-for="EndDate" id="endDate" class="form-control" type="date" readonly />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">End Time</label>
                    <input asp-for="EndTime" id="endTime" type="text" class="form-control timepicker" required />
                </div>
            </div>

            <form id="createMeetingForm" method="post" asp-action="CreateMeeting">
                <div class="mb-3">
                    <label class="form-label fw-bold">Agenda</label>
                    <textarea asp-for="Agenda" class="form-control" rows="3" placeholder="Enter meeting agenda"></textarea>
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" id="createMeetingBtn" class="btn btn-primary btn-lg">Create Meeting</button>
                </div>
            </form>

        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const calendarEl = document.getElementById('calendar');
        const zoomFilter = document.getElementById('zoomFilter');
        let selectedMeetingId = null;

        // Ambil email user yang login dari ViewBag
        const userEmail = '@ViewBag.UserEmail';
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const endTimeInput = $('#endTime');
        const startTimeInput = $('#startTime');

        // Set End Date to always match Start Date
        startDateInput.addEventListener('change', function () {
            endDateInput.value = startDateInput.value;
            refreshTimePickers();
        });

        // Initialize End Date on first load
        if (startDateInput.value) {
            endDateInput.value = startDateInput.value;
        }

        // Function to get current time in proper format
        function getCurrentTime() {
            const now = new Date();
            let hours = now.getHours();
            let minutes = now.getMinutes();

            // Round up to next 30-minute interval
            if (minutes > 0 && minutes <= 30) {
                minutes = 30;
            } else if (minutes > 30) {
                hours += 1;
                minutes = 0;
            }

            // Convert to 12-hour format with AM/PM
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12; // the hour '0' should be '12'
            minutes = minutes < 10 ? '0' + minutes : minutes;

            return hours + ':' + minutes + ' ' + ampm;
        }

        // Refresh time pickers (if needed)
        function refreshTimePickers() {
            initTimePickers();
        }

        // Update end time based on start time (+30 minutes)
        function updateEndTime() {
            const startTime = startTimeInput.val();
            if (!startTime) return;

            // Parse start time
            const timeParts = startTime.split(/:| /);
            let hours = parseInt(timeParts[0]);
            const minutes = parseInt(timeParts[1]);
            const ampm = timeParts[2];

            // Convert to 24-hour format for calculation
            if (ampm === 'PM' && hours !== 12) {
                hours += 12;
            } else if (ampm === 'AM' && hours === 12) {
                hours = 0;
            }

            // Add 30 minutes to start time for end time
            let endHours = hours;
            let endMinutes = minutes + 30;

            if (endMinutes >= 60) {
                endHours += 1;
                endMinutes -= 60;
            }

            // Convert back to 12-hour format for display
            const endAmpm = endHours >= 12 ? 'PM' : 'AM';
            endHours = endHours % 12;
            endHours = endHours ? endHours : 12;
            const formattedEndMinutes = endMinutes < 10 ? '0' + endMinutes : endMinutes;

            const endTime = endHours + ':' + formattedEndMinutes + ' ' + endAmpm;

            // Update end time picker with new minTime and reset time list
            endTimeInput.timepicker('option', {
                'minTime': endTime,
                'startTime': endTime, // Set start of dropdown list to endTime
                'maxTime': '11:30 PM',
                'interval': 30
            });
            endTimeInput.timepicker('setTime', endTime);
        }

        // Initialize timepickers
        function initTimePickers() {
            const currentTime = getCurrentTime();

            // Start Time Picker
            startTimeInput.timepicker({
                timeFormat: 'h:mm p',
                interval: 30,
                minTime: currentTime,
                startTime: currentTime,
                dynamic: false,
                dropdown: true,
                scrollbar: true
            });

            // Set initial start time
            startTimeInput.timepicker('setTime', currentTime);

            // End Time Picker
            endTimeInput.timepicker({
                timeFormat: 'h:mm p',
                interval: 30,
                dynamic: false,
                dropdown: true,
                scrollbar: true
            });

            // Update end time when start time changes
            startTimeInput.on('changeTime', function () {
                updateEndTime();
            });

            // Initial update
            updateEndTime();
        }

        // Initialize the timepickers on page load
        document.addEventListener('DOMContentLoaded', function () {
            initTimePickers();
        });


        // Initialize everything when document is ready
        $(document).ready(function () {
            initTimePickers();
        });

        function fetchAccounts() {
            fetch('/Home/GetZoomAccounts')
                .then(response => response.json())
                .then(accounts => {
                    accounts.forEach(account => {
                        const option = document.createElement("option");
                        option.value = account;
                        option.textContent = account;
                        zoomFilter.appendChild(option);
                    });
                });
        }

        function showMeetingDetail(event) {
            const start = new Date(event.start).toLocaleString();
            const end = event.end ? new Date(event.end).toLocaleString() : "-";
            const startUrl = event.extendedProps.startUrl;
            const joinUrl = event.extendedProps.joinUrl;
            const email = event.extendedProps.creatorEmail;
            const meetingId = event.id;
            selectedMeetingId = event.id;

            // Cek apakah user yang login adalah creator
            const isCreator = email.toLowerCase() === userEmail.toLowerCase();

            Swal.fire({
                title: `Topic: ${event.title}`,
                html: `
                            <div style="text-align: left">
                                <p><strong>Meeting ID:</strong> ${meetingId}</p>
                                <p><strong>Creator Email:</strong> ${email}</p>
                                <p><strong>Start:</strong> ${start}</p>
                                <p><strong>End:</strong> ${end}</p>
                                <p><strong>Start URL (Host Only):</strong><br>
                                    <a href="${startUrl}" target="_blank" class="swal2-confirm swal2-styled" style="margin-top: 5px;">Start Meeting</a>
                                </p>
                                <p><strong>Join URL (Participant):</strong><br>
                                    <a href="${joinUrl}" target="_blank" class="swal2-confirm swal2-styled" style="margin-top: 5px;">Join Meeting</a>
                                </p>
                            </div>
                        `,
                showCancelButton: true,
                showDenyButton: isCreator,
                confirmButtonText: isCreator ? 'Reschedule' : '',
                denyButtonText: isCreator ? 'Cancel Meeting' : '',
                cancelButtonText: 'Close',
            }).then(result => {
                if (result.isConfirmed) {
                    showRescheduleForm(event);
                } else if (result.isDenied) {
                    confirmCancelMeeting();
                }
            });
        }

        function showRescheduleForm(event) {
            const start = new Date(event.start).toISOString().slice(0, 16);
            const end = event.end ? new Date(event.end).toISOString().slice(0, 16) : '';

            Swal.fire({
                title: 'Reschedule Meeting',
                html: `
                            <label>New Start:</label>
                            <input type="datetime-local" id="swalStart" class="swal2-input" value="${start}">
                            <label>New End:</label>
                            <input type="datetime-local" id="swalEnd" class="swal2-input" value="${end}">
                        `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Confirm',
                cancelButtonText: 'Back',
                preConfirm: () => {
                    const newStart = document.getElementById('swalStart').value;
                    const newEnd = document.getElementById('swalEnd').value;

                    if (!newStart || !newEnd) {
                        Swal.showValidationMessage("Both start and end time are required.");
                        return false;
                    }

                    return { newStart, newEnd };
                }
            }).then(result => {
                if (result.isConfirmed) {
                    const { newStart, newEnd } = result.value;

                    fetch(`/Home/RescheduleMeeting`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            meetingId: selectedMeetingId,
                            newStart,
                            newEnd
                        })
                    }).then(res => {
                        if (res.ok) {
                            Swal.fire("Success", "Meeting rescheduled successfully!", "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Error", "Failed to reschedule meeting.", "error");
                        }
                    });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    showMeetingDetail(event);
                }
            });
        }

        function confirmCancelMeeting() {
            Swal.fire({
                title: 'Are you sure?',
                text: "This meeting will be cancelled!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, cancel it!',
                cancelButtonText: 'No, keep it'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Home/CancelMeeting?meetingId=${selectedMeetingId}`, { method: 'POST' })
                        .then(res => {
                            if (res.ok) {
                                Swal.fire('Cancelled!', 'The meeting has been cancelled.', 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error', 'Failed to cancel meeting.', 'error');
                            }
                        });
                }
            });
        }

        function fetchEvents(zoomAccount) {
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: '/Home/GetCalendarEvents?zoomAccount=' + zoomAccount,
                eventClick: function (info) {
                    info.jsEvent.preventDefault();
                    showMeetingDetail(info.event);
                }
            });

            calendar.render();
        }

        fetchAccounts();
        fetchEvents("all");

        zoomFilter.addEventListener("change", function () {
            fetchEvents(zoomFilter.value);
        });


    });
</script>


